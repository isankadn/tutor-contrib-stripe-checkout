        "secret_uid": {{ STRIPE_CHECKOUT_SECRET_UID }},
        "secret_gid": {{ STRIPE_CHECKOUT_SECRET_GID }},
        "callback_max_age": {{ STRIPE_CHECKOUT_CALLBACK_MAX_AGE }},
        "webhook_tolerance": {{ STRIPE_CHECKOUT_WEBHOOK_TOLERANCE }},
